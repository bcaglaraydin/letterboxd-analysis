# ==============================================================================
# Letterboxd Analysis - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# This file is used by: Docker Compose, server.js, unit tests
# ==============================================================================

# AWS Configuration
AWS_REGION=eu-west-1

# DynamoDB Tables 
FILMS_TABLE=''
USER_JOBS_TABLE=''

# SQS Queues 
# Queue for scraping user lists → triggers list-scraper Lambda
SQS_LIST_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<ACCOUNT_ID>/list-scrape-queue
# Queue for scraping individual films → triggers worker Lambda
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<ACCOUNT_ID>/film-scrape-queue

# Browser Settings (container only)
CHROMIUM_PATH=/opt/browsers
BROWSER_MAX_PAGES=5
SCRAPING_CONCURRENCY_LIST=2
SCRAPING_CONCURRENCY_FILM=5

# Application Mode
NODE_ENV=development
